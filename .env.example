# ============================================
# API 키 설정 파일 (양식)
# ============================================
# 사용법
#   1) 이 파일을 .env 로 복사한다
#        cp .env.example .env
#   2) 필요한 키만 값을 채운다
#
# 주의
#   .env 는 .gitignore 에 등록되어 있어 저장소에 올라가지 않습니다.
#   키를 코드에 직접 쓰거나 저장소에 올리면 안 됩니다.
#   자세한 내용은 25번 노트북 1절을 참조하세요.
# ============================================

# --- 무료로 시작할 수 있는 곳 (카드 불필요) ---
# Google AI Studio  https://aistudio.google.com
GEMINI_API_KEY=

# Groq              https://console.groq.com
GROQ_API_KEY=

# OpenRouter        https://openrouter.ai
OPENROUTER_API_KEY=

# --- 카드 등록 필요 ---
# OpenAI            https://platform.openai.com
OPENAI_API_KEY=

# --- 기타 ---
# Hugging Face (게이트 모델 다운로드 시)
HF_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# --- 모델·제공처 조정 (선택) — 25번 노트북 2절 '모델이 사라졌을 때' ---
# 모델 이름은 제공처가 바꾸거나 종료합니다. 404 오류가 나면 제공처 문서에서 현재 모델 이름을 확인해 적으세요.
# 비워 두면 책의 기본값을 씁니다.
LLM_MODEL=
# 키가 여러 개일 때 쓸 제공처: openai | groq | gemini
LLM_PROVIDER=
# 호출 사이에 기다릴 초 (429 한도 오류가 자주 나면 3~10 정도로)
LLM_CALL_INTERVAL=
# 직접 띄운 OpenAI 호환 서버를 쓸 때만 채우세요 (예: http://localhost:11434/v1)
# 이때 LLM_MODEL 에는 그 서버의 모델 이름을, LLM_API_KEY 에는 아무 값이나 적습니다.
LLM_BASE_URL=
LLM_API_KEY=
